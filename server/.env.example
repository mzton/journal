# ---------------------------------------------------------------------------
# server/.env — copy to server/.env for local dev. On Railway, set these as
# service Variables instead (DATABASE_URL is provided automatically once you
# attach the Postgres plugin — reference it as ${{Postgres.DATABASE_URL}}).
# ---------------------------------------------------------------------------

# Postgres connection string.
#   Local dev: a local/Docker Postgres (no SSL) — the default below.
#   Supabase:  Dashboard -> Project Settings -> Database -> Connection string.
#     For a server hosted on Railway, use a POOLER string and append
#     ?sslmode=require. Session pooler (port 5432 — works for both the API and
#     Drizzle migrations) example:
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading_journal

# Secret used to sign JWTs. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long an access token stays valid.
JWT_EXPIRES_IN=7d

# Port the API listens on. Railway sets PORT automatically; 8080 is the local default.
PORT=8080

# Comma-separated list of allowed browser origins (your Vercel URLs).
# Include your production domain and any preview/localhost origins you use.
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Directory where uploaded screenshots are written. On Railway, mount a
# persistent Volume and point this at its mount path (e.g. /data/uploads).
UPLOAD_DIR=./uploads
